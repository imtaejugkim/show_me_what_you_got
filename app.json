{
  "expo": {
    "name": "Show Me What You Got",
    "slug": "show-me-what-you-got",
    "scheme": "smwyg",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.imtaejugkim.showmewhatyougot",
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "package": "com.imtaejugkim.showmewhatyougot",
      "adaptiveIcon": {
        "backgroundColor": "#D7FF3F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "등록한 헬스장/독서실 근처에 도착하면 인증을 시작할 수 있도록 알려드리기 위해 위치를 사용합니다.",
          "locationWhenInUsePermission": "장소를 등록하고 현재 위치가 장소 안인지 확인하기 위해 위치를 사용합니다.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0B0B0C",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "운동·공부 장소에서 인증 사진을 찍기 위해 카메라를 사용합니다.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "backgroundColor": "#0B0B0C"
  }
}
